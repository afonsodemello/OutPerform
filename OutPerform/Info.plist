<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>mamilles.OutPerform.refresh</string>
		<string>mamilles.OutPerform.processing</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>mamilles.OutPerform.googleauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.outperform.app</string>
			</array>
		</dict>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>OutPerform connects directly to your band over Bluetooth to record heart rate and heartbeats on this iPhone. Nothing is sent to the cloud.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>OutPerform uses your location during workouts you start in the Exercise tab to measure distance, pace and your route. It stays on this iPhone.</string>
	<key>NSMotionUsageDescription</key>
	<string>OutPerform uses motion data during workouts to count steps, cadence, floors and elevation gain. It stays on this iPhone.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
